<?xml version="1.0" encoding="utf-8"?>
<!-- A minimal Windows Installer package: one file in Program Files and one registry value. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="7b1e3c52-9a4d-4f60-8c2e-1d5a6b7c8d90" Name="Raven Sample" Language="1033" Version="1.2.3" Manufacturer="Raven" UpgradeCode="5d2f4a7e-1b3c-4e8d-9a6f-2c7b8e9d0a11">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"/>
    <Media Id="1" Cabinet="sample.cab" EmbedCab="yes"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="RavenSample">
          <Component Id="Payload" Guid="0c8a1e44-6d2b-4f7a-8b3e-5a9c1d2e3f40">
            <File Id="Hello" Name="hello.txt" Source="msi_payload.txt" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\RavenSample" Name="Installed" Type="integer" Value="1"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="Payload"/>
    </Feature>
  </Product>
</Wix>
