--- a/dll/win32/gdiplus/graphics.c
+++ b/dll/win32/gdiplus/graphics.c
@@ -4093,13 +4093,46 @@
         /* draw output image */
         if (stat == Ok)
         {
+            HRGN drawn = NULL;
+
+            /* Copying the source replaces only the pixels the pen covers, as Windows does: the rest of the output area keeps what is
+             * there. The covered pixels are those the stroke wrote, which are not left at zero. */
+            if (graphics->compmode == CompositingModeSourceCopy)
+            {
+                INT x, y;
+
+                drawn = CreateRectRgn(0, 0, 0, 0);
+                for (y = 0; drawn && y < output_height; y++)
+                {
+                    for (x = 0; x < output_width; x++)
+                    {
+                        INT start = x;
+                        HRGN span;
+
+                        while (x < output_width && output_bits[x + y * output_width])
+                            x++;
+                        if (x == start)
+                            continue;
+                        span = CreateRectRgn(output_area.left + start, output_area.top + y, output_area.left + x, output_area.top + y + 1);
+                        if (span)
+                        {
+                            CombineRgn(drawn, drawn, span, RGN_OR);
+                            DeleteObject(span);
+                        }
+                    }
+                }
+            }
+
             gdi_transform_acquire(graphics);
 
-            stat = alpha_blend_pixels(graphics, output_area.left, output_area.top,
+            stat = alpha_blend_pixels_hrgn(graphics, output_area.left, output_area.top,
                 (BYTE*)output_bits, output_width, output_height, output_width * 4,
-                PixelFormat32bppARGB);
+                drawn, PixelFormat32bppARGB);
 
             gdi_transform_release(graphics);
+
+            if (drawn)
+                DeleteObject(drawn);
         }
 
         free(brush_bits);
