+typedef struct
+{
+    BOOL failed;
+    DWORD error;
+} layout_failure;
+
+static BOOL layout_extent_ex(layout_failure *failure, HDC dc, LPCWSTR text,
+                             int count, int maximum, LPINT fit, LPINT widths, LPSIZE size)
+{
+    if (GetTextExtentExPointW(dc, text, count, maximum, fit, widths, size)) return TRUE;
+    if (!failure->failed) failure->error = GetLastError();
+    failure->failed = TRUE;
+    size->cx = size->cy = 0;
+    if (fit) *fit = 0;
+    return FALSE;
+}
+
+static BOOL layout_extent(layout_failure *failure, HDC dc, LPCWSTR text, int count, LPSIZE size)
+{
+    if (GetTextExtentPointW(dc, text, count, size)) return TRUE;
+    if (!failure->failed) failure->error = GetLastError();
+    failure->failed = TRUE;
+    size->cx = size->cy = 0;
+    return FALSE;
+}
